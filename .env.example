# ── SERVER variables (set these in Railway → your service → Variables) ──

# Postgres backend store. Reference the Railway Postgres plugin, e.g.:
#   BACKEND_STORE_URI=${{Postgres.DATABASE_URL}}
# (If Railway hands you a URL starting with postgres://, change it to postgresql://)
BACKEND_STORE_URI=

# Where artifacts (rerun files, videos) live, in your R2 bucket:
ARTIFACT_ROOT=s3://your-r2-bucket/artifacts

# Cloudflare R2 credentials (token with Object Read & Write on the bucket):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
MLFLOW_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com

# Admin login (created on first boot). CHANGE THE PASSWORD.
MLFLOW_ADMIN_USERNAME=admin
MLFLOW_ADMIN_PASSWORD=change-me-please

# Optional: put the auth user-list in a separate DB. Defaults to BACKEND_STORE_URI.
# AUTH_DATABASE_URI=

# ── CLIENT variables (set these wherever record_experiment.py runs: the agent, you, Alex) ──
# Note: clients need NO R2 creds — artifacts are proxied through the server.
# MLFLOW_TRACKING_URI=https://<your-railway-app>.up.railway.app
# MLFLOW_TRACKING_USERNAME=<user>
# MLFLOW_TRACKING_PASSWORD=<pass>
